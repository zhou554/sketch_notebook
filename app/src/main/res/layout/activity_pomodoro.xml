<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <com.example.notesketch.ScrapbookPaperView
        android:id="@+id/paperBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/btnBackRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/patrick_hand"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="‹ 返回"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/patrick_hand"
                android:gravity="end"
                android:text="番茄钟"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:id="@+id/headerLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginHorizontal="16dp"
            android:background="#597A6F62" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:id="@+id/modeSegment"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/btnModeStopwatch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/patrick_hand"
                        android:gravity="center"
                        android:text="正计时"
                        android:textSize="15sp" />

                    <View
                        android:id="@+id/modeDivider1"
                        android:layout_width="1.5dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:id="@+id/btnModeCountdown"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/patrick_hand"
                        android:gravity="center"
                        android:text="倒计时"
                        android:textSize="15sp" />

                    <View
                        android:id="@+id/modeDivider2"
                        android:layout_width="1.5dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:id="@+id/btnModePomodoro"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/patrick_hand"
                        android:gravity="center"
                        android:text="番茄钟"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgTomato"
                    android:layout_width="180dp"
                    android:layout_height="144dp"
                    android:layout_marginTop="18dp"
                    android:contentDescription="番茄"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tomato_fanqie" />

                <TextView
                    android:id="@+id/tvPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/patrick_hand"
                    android:text="准备开始"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/patrick_hand"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textSize="56sp" />

                <HorizontalScrollView
                    android:id="@+id/presetScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/presetRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="2dp" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPrimary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/patrick_hand"
                        android:gravity="center"
                        android:text="开始"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnReset"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/patrick_hand"
                        android:gravity="center"
                        android:text="重置"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSkip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/patrick_hand"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="跳过当前阶段"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/statsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvStatsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/patrick_hand"
                        android:text="今日专注"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/patrick_hand"
                        android:text="已完成 0 个番茄 · 累计 0 分钟"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
