<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.notesketch.SeaSceneView
        android:id="@+id/seaScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="返回"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:text="设置"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/headerLine"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/sectionLook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:text="外观"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/labelOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="20dp"
                android:paddingTop="14dp"
                android:text="列表格透明度"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <SeekBar
                    android:id="@+id/seekOpacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/valOpacity"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hintOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="2dp"
                android:text="列表格浮在底部海景上，数值越低海景越清晰"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/labelTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:text="主题颜色"
                android:textSize="11sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/themeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/sectionSea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:text="海景"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/labelSeaHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="20dp"
                android:paddingTop="14dp"
                android:text="海浪高度"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <SeekBar
                    android:id="@+id/seekSeaHeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/valSeaHeight"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/labelSeaAmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:text="海浪起伏"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <SeekBar
                    android:id="@+id/seekSeaAmp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/valSeaAmp"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/labelShell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:text="贝壳出现频率"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <SeekBar
                    android:id="@+id/seekShell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/valShell"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hintShell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="4dp"
                android:text="0 为关闭贝壳；数值越高出现越频繁"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
