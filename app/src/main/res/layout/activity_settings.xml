<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <com.example.notesketch.ScrapbookPaperView
        android:id="@+id/paperBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="40dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/patrick_hand"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingEnd="12dp"
                    android:text="‹ 返回"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/patrick_hand"
                    android:text="手账设置"
                    android:textSize="22sp" />
            </LinearLayout>

            <View
                android:id="@+id/headerLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginHorizontal="16dp"
                android:background="#597A6F62" />

            <TextView
                android:id="@+id/sectionLook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/patrick_hand"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:text="纸张色调"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/labelTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/patrick_hand"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:text="选择手账主题"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/themeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/hintOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/patrick_hand"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:text="长按主页丝带标题可打开此页"
                android:textSize="15sp" />

            <!-- 保留旧控件 id，隐藏海景相关 -->
            <SeekBar
                android:id="@+id/seekOpacity"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/valOpacity"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/labelOpacity"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/sectionSea"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <SeekBar
                android:id="@+id/seekSeaHeight"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/valSeaHeight"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/labelSeaHeight"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <SeekBar
                android:id="@+id/seekSeaAmp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/valSeaAmp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/labelSeaAmp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <SeekBar
                android:id="@+id/seekShell"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/valShell"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/labelShell"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/hintShell"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
