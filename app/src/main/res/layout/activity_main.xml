<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <com.example.notesketch.ScrapbookPaperView
        android:id="@+id/paperBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 胶带装饰 -->
    <View
        android:id="@+id/tapeV"
        android:layout_width="28dp"
        android:layout_height="110dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_tape_v"
        android:elevation="1dp"
        android:rotation="-4" />

    <View
        android:id="@+id/tapeH"
        android:layout_width="100dp"
        android:layout_height="22dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_tape_h"
        android:elevation="1dp"
        android:rotation="2" />

    <!-- 标题丝带 -->
    <TextView
        android:id="@+id/ribbon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_ribbon"
        android:elevation="4dp"
        android:fontFamily="@font/patrick_hand"
        android:paddingHorizontal="36dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:rotation="-0.8"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="23sp" />

    <!-- 侧边复习间隔木牌 -->
    <LinearLayout
        android:id="@+id/sideBoard"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_side_board"
        android:elevation="3dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:rotation="1.5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/patrick_hand"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="复习\n间隔"
            android:textColor="#F6E8DC"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/intervalDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="1\n2\n4\n7\n15\n30"
            android:textColor="#FFE8D4"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 狐狸贴纸 -->
    <ImageView
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="4dp"
        android:alpha="0.9"
        android:contentDescription="@null"
        android:elevation="2dp"
        android:rotation="-10"
        android:scaleType="fitCenter"
        android:src="@drawable/fox_deco" />

    <ImageView
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="58dp"
        android:layout_marginBottom="40dp"
        android:alpha="0.9"
        android:contentDescription="@null"
        android:elevation="2dp"
        android:rotation="8"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/fox_deco" />

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="200dp"
        android:alpha="0.72"
        android:contentDescription="@null"
        android:elevation="2dp"
        android:rotation="6"
        android:scaleType="fitCenter"
        android:src="@drawable/fox_deco" />

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="160dp"
        android:layout_marginEnd="64dp"
        android:alpha="0.72"
        android:contentDescription="@null"
        android:elevation="2dp"
        android:rotation="-6"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/fox_deco" />

    <!-- journal content -->
    <LinearLayout
        android:id="@+id/journalFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_journal_frame"
        android:elevation="5dp"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingTop="10dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/patrick_hand"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="32dp"
                android:text="这一页还空着\n点下方狐狸，或滑到底写下便签"
                android:textColor="@color/muted"
                android:textSize="20sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/journalFoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/fabAdd"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:clickable="true"
                android:contentDescription="新建笔记"
                android:focusable="true"
                android:scaleType="fitCenter"
                android:src="@drawable/fox_sticker" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/patrick_hand"
                android:text="新建"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部森林 peeks（盖在内容两侧外缘） -->
    <ImageView
        android:id="@+id/forestLeft"
        android:layout_width="170dp"
        android:layout_height="110dp"
        android:layout_gravity="bottom|start"
        android:alpha="0.88"
        android:contentDescription="@null"
        android:elevation="1dp"
        android:scaleType="fitStart"
        android:src="@drawable/forest_deco" />

    <ImageView
        android:id="@+id/forestRight"
        android:layout_width="170dp"
        android:layout_height="110dp"
        android:layout_gravity="bottom|end"
        android:alpha="0.88"
        android:contentDescription="@null"
        android:elevation="1dp"
        android:scaleType="fitEnd"
        android:scaleX="-1"
        android:src="@drawable/forest_deco" />

    <!-- 右上角狐狸头：设置入口 -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="手账设置"
        android:elevation="6dp"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/fox_deco" />

    <View
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/headerLine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
