<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clipToPadding="false"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/stickerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sticker_yellow"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMood"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="心情图标"
                android:scaleType="fitCenter"
                tools:src="@drawable/mood_fox_1" />

            <TextView
                android:id="@+id/tvMood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/patrick_hand"
                android:textColor="@color/ink"
                android:textSize="20sp"
                tools:text="元气满满" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="@color/muted"
            android:textSize="13sp"
            tools:text="今天的心情记录" />

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="心情图片"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textSize="10sp"
                tools:text="07月15日 20:30" />

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_tear"
                android:fontFamily="@font/patrick_hand"
                android:gravity="center"
                android:minHeight="28dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="撕掉"
                android:textColor="@color/muted"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
