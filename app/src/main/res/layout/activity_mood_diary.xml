<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <com.example.notesketch.ScrapbookPaperView
        android:id="@+id/paperBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/btnBackRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/patrick_hand"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="‹ 返回"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/patrick_hand"
                android:gravity="end"
                android:text="心情日记"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:id="@+id/headerLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginHorizontal="16dp"
            android:background="#597A6F62" />

        <com.example.notesketch.InertialNestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/sectionAdd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/patrick_hand"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="14dp"
                    android:text="今天的心情"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/labelIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/patrick_hand"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="10dp"
                    android:text="选择图标"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/iconRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/labelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/patrick_hand"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="12dp"
                    android:text="标题"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/patrick_hand"
                    android:gravity="center_vertical"
                    android:hint="例如：今天很开心"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/labelContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/patrick_hand"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="12dp"
                    android:text="内容"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etContent"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/patrick_hand"
                    android:gravity="center_vertical"
                    android:hint="写点什么…"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnAddEntry"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/patrick_hand"
                    android:gravity="center"
                    android:text="保存心情"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/sectionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/patrick_hand"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="6dp"
                    android:text="最近记录"
                    android:textSize="17sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/emptyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/patrick_hand"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="还没有心情记录\n保存第一条，从这里开始"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.example.notesketch.InertialNestedScrollView>
    </LinearLayout>
</FrameLayout>
