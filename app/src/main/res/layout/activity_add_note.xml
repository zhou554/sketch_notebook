<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.example.notesketch.SeaLineView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shell_scrim"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hairline_bottom"
            android:fontFamily="serif"
            android:letterSpacing="0.06"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="14dp"
            android:text="新建笔记"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:text="标题"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stroke_rect"
                    android:hint="例如：英语单词 Unit 3"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="2"
                    android:minHeight="44dp"
                    android:padding="12dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:text="内容"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stroke_rect"
                    android:gravity="top"
                    android:hint="笔记内容 / 知识点…"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:minLines="8"
                    android:padding="12dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:letterSpacing="0.04"
            android:minHeight="48dp"
            android:text="保存笔记"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="0dp"
            app:rippleColor="@color/accent_soft"
            app:strokeColor="@color/ink"
            app:strokeWidth="1dp" />
    </LinearLayout>
</FrameLayout>
