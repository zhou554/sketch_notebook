<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <com.example.notesketch.ScrapbookPaperView
        android:id="@+id/paperBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/btnBackRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/patrick_hand"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="‹ 返回"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/patrick_hand"
                android:gravity="end"
                android:text="专注统计"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:id="@+id/headerLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginHorizontal="16dp"
            android:background="#597A6F62" />

        <com.example.notesketch.InertialScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:id="@+id/rangeSegment"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/btnRangeDay"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/patrick_hand"
                        android:gravity="center"
                        android:text="日"
                        android:textSize="15sp" />

                    <View
                        android:id="@+id/rangeDivider1"
                        android:layout_width="1.5dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:id="@+id/btnRangeMonth"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/patrick_hand"
                        android:gravity="center"
                        android:text="月"
                        android:textSize="15sp" />

                    <View
                        android:id="@+id/rangeDivider2"
                        android:layout_width="1.5dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:id="@+id/btnRangeYear"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/patrick_hand"
                        android:gravity="center"
                        android:text="年"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/summaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSummaryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/patrick_hand"
                        android:text="今日"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvSummaryValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/patrick_hand"
                        android:text="0 分钟 · 0 个番茄"
                        android:textSize="24sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvListTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/patrick_hand"
                    android:text="最近 30 天"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/statsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/emptyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/patrick_hand"
                    android:gravity="center"
                    android:text="暂无专注记录，完成番茄后会自动统计"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.example.notesketch.InertialScrollView>
    </LinearLayout>
</FrameLayout>
